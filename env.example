# ===== ZAROORI =====
# Apna WhatsApp number country code ke saath, bina + ya space ke (India: 91XXXXXXXXXX)
PAIRING_NUMBER=919999999999
# Pairing code dekhne ke liye /pair?key=YAHI_KEY
ADMIN_KEY=koi-strong-password

# ===== BASIC =====
AUTO_REPLY_ENABLED=true
REPLY_MESSAGE=Namaste {name}! Main abhi busy hoon, thodi der me reply karunga.
REPLY_TO_GROUPS=false
REPLY_DELAY_SECONDS=2
# Ek hi number ko dobara auto reply kitne minute baad (spam se bachne ke liye)
COOLDOWN_MINUTES=60
TIMEZONE=Asia/Kolkata

# ===== KHAS NUMBERS =====
# Khali = sabko reply. Bhara = sirf inhe reply (comma se alag)
ALLOWED_NUMBERS=
# In numbers ko kabhi reply nahi
BLOCKED_NUMBERS=
# Kisi khas number ke liye alag reply (JSON)
CUSTOM_REPLIES={"919888888888":"Hello boss! Aapka message mil gaya."}
# Keyword based reply (JSON) - message me keyword mile to ye reply
KEYWORD_REPLIES={"price":"Price list: example.com/price","hi":"Hello {name}!"}

# ===== SCHEDULE =====
# Bot in ghanto me normal reply dega. Khali = 24x7
ACTIVE_HOURS=09:00-21:00
# Active time ke baad ye message (khali = koi reply nahi)
OFFLINE_MESSAGE=Abhi office band hai. Kal 9 baje reply milega.
# Din: mon,tue,wed,thu,fri,sat,sun (khali = roz)
ACTIVE_DAYS=mon,tue,wed,thu,fri,sat
# Fixed time par apne aap message bhejna (JSON list)
# days optional hai, "*" ya ["mon","fri"]
SCHEDULED_MESSAGES=[{"number":"919777777777","time":"09:00","days":"*","message":"Good morning!"}]

# ===== OWNER COMMANDS =====
# Ye number bot ko control kar sakta hai (!on !off !status !send). Khali = PAIRING_NUMBER
OWNER_NUMBER=

# ===== SESSION =====
# Render/Railway par persistent disk/volume lagao aur yahan uska path do, jaise /data/auth
AUTH_DIR=auth
